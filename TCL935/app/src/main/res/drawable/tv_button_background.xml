<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFCA28" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="9dp" />
            <padding android:left="18dp" android:top="10dp" android:right="18dp" android:bottom="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#00D9FF" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="9dp" />
            <padding android:left="18dp" android:top="10dp" android:right="18dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#253746" />
            <stroke android:width="2dp" android:color="#7192A5" />
            <corners android:radius="9dp" />
            <padding android:left="18dp" android:top="10dp" android:right="18dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
